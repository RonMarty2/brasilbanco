# ========================================================
# VARIABLES DE ENTORNO - SISTEMA DE CONTROL DE REMESAS
# ========================================================

# Puerto del Backend FastAPI
PORT=8000
HOST=0.0.0.0

# Clave API de Google Gemini (Para Gemini Flash Vision)
GEMINI_API_KEY=tu_clave_gemini_api_aqui

# Integración con Google Sheets
# ID extraído de la URL: https://docs.google.com/spreadsheets/d/<ESTE_ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=tu_spreadsheet_id_aqui
GOOGLE_SHEETS_CREDENTIALS_FILE=service_account.json

# Modo del sistema: 'production' o 'development' (activa simulador cuando falte API key)
SYSTEM_MODE=development

# Configuración de base de datos SQLite (ruta relativa o absoluta)
DATABASE_PATH=remesas.db
